{
    "name": "my-todolist-package",
    "version": "1.0.0",
    "description": "A simple Todo List package written in TypeScript",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/your-repo/my-todolist-package.git"
    },
    "keywords": [
        "todolist",
        "typescript",
        "tasks",
        "package"
    ],
    "author": "Your Name <your.email@example.com>",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/your-repo/my-todolist-package/issues"
    },
    "homepage": "https://github.com/your-repo/my-todolist-package#readme",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./todoItem/element-definition": "./dist/todoItem/element-definition.js",
        "./todoItem/interface.html": "./dist/todoItem/interface.html"
    },
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "tsc && npm run copy-html",
        "copy-html": "copyfiles -u 1 ./src/**/*.html dist",
        "test": "jest",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.4",
        "typescript": "^5.5.4"
    }
}
