﻿{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "/",
    "declarationMap": true,
    "inlineSourceMap": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.js", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
